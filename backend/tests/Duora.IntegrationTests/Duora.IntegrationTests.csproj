<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../src/Duora.MediaProtocol/Duora.MediaProtocol.csproj" />
    <ProjectReference Include="../../src/Duora.MediaSanitizer/Duora.MediaSanitizer.csproj" Aliases="sanitizer" />
    <ProjectReference Include="..\..\src\Duora.Infrastructure\Duora.Infrastructure.csproj" />
    <ProjectReference Include="../Duora.MediaBaselineHost/Duora.MediaBaselineHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Duora.SelfieProcessHost/Duora.SelfieProcessHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Duora.StorageAuthority/Duora.StorageAuthority.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Duora.Web\Duora.Web.csproj" />
    <!-- Alias: o Program interno do Worker colidiria com o Program do Web. -->
    <ProjectReference Include="..\..\src\Duora.Worker\Duora.Worker.csproj" Aliases="worker" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <!-- Chave do key ring sem o certificado: a falha é definitiva, mas o DefaultKeyResolver do Data Protection repete a
       decifragem 10 vezes com Thread.Sleep(200 ms), prendendo uma thread do pool por cerca de 2 s a cada resolução
       (#455). 0 desliga os retries só no processo de testes; a produção continua com o padrão do framework. É a
       chave de AppContext que o próprio framework lê (KeyManagementOptions é internal), entregue pelo runtimeconfig. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.DataProtection.KeyManagement.MaximumTotalDefaultKeyResolverRetries"
                                    Value="0" />
  </ItemGroup>
  <!-- The SDK's dotnet test console suppresses successful test-host output. Record this synthetic
       experiment directly on the hosted backend runner, then keep the full existing test gate unchanged.
       Ordinary/local builds and every other CI job do not execute this target. -->
  <Target Name="RecordSyntheticSanitizerBaseline" AfterTargets="Build"
          Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(GITHUB_JOB)' == 'backend'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; -class Duora.IntegrationTests.Media.SanitizerResourceEnvelopeTests -showLiveOutput -reporter verbose"
          StandardOutputImportance="High" />
  </Target>
</Project>
