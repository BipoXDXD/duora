<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Xunit" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../../src/Duora.Infrastructure/Duora.Infrastructure.csproj" />
    <!-- Execute exactly the production consumer, without starting unrelated workers. -->
    <Compile Include="../../src/Duora.Worker/SelfieVerificationProviderService.cs" Link="SelfieVerificationProviderService.cs" />
  </ItemGroup>
</Project>
