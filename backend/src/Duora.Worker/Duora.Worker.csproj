<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <UserSecretsId>duora-local-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Duora.Core\Duora.Core.csproj" />
    <ProjectReference Include="..\Duora.Contracts\Duora.Contracts.csproj" />
    <ProjectReference Include="..\Duora.Infrastructure\Duora.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Só o Worker decodifica imagem: o Web nunca carrega o decoder (ADR-0025, DependencyRulesTests). -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes de integração sobem o host pelo mesmo WorkerHost do Program. -->
    <InternalsVisibleTo Include="Duora.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- O SDK Worker publica todo *.json como conteúdo; o lockfile é só do restore. -->
    <Content Update="packages.lock.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
