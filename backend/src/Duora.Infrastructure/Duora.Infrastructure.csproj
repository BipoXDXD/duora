<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Duora.Core\Duora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <!-- Segredos como arquivos (Compose secrets); o Worker não tem o shared framework do ASP.NET Core. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.KeyPerFile" />
    <!-- Só para o dotnet-ef gerar migrations; não vai para quem referencia este projeto. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes de integração aplicam as migrations com o DbContext interno, como fará o job migrador. -->
    <InternalsVisibleTo Include="Duora.IntegrationTests" />
  </ItemGroup>
</Project>
