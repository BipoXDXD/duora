<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sem o framework compartilhado do ASP.NET Core: o Worker depende deste projeto e roda no runtime .NET puro.
       O que exige o runtime web (cookie, ticket store, SignInManager, Data Protection) fica no Duora.Web.Identity
       (ADR-0019, "Revisão: separação do runtime web"; verificado em Duora.ArchitectureTests). -->
  <ItemGroup>
    <ProjectReference Include="..\Duora.Core\Duora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <!-- Pacote NuGet, não o framework compartilhado: traz IdentityDbContext, UserManager e PasswordHasher. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- JIT reflection reader: omit only the vendor's optional AOT generator, which emits an unmarked
         foreign-namespace registration. Keep .NET analyzers and the architecture gate unchanged. -->
    <PackageReference Include="MaxMind.Db" ExcludeAssets="analyzers" />
    <PackageReference Include="AWSSDK.Rekognition" />
    <PackageReference Include="AWSSDK.SecurityToken" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <!-- Segredos como arquivos (Compose secrets); o Worker não tem o shared framework do ASP.NET Core. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.KeyPerFile" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <!-- Só para o dotnet-ef gerar migrations; não vai para quem referencia este projeto. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes de integração aplicam as migrations com o DbContext interno, como fará o job migrador. -->
    <InternalsVisibleTo Include="Duora.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Geolocation/Licenses/MaxMind.Db/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          TargetPath="licenses/MaxMind.Db/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- ResolvePackageAssets can still supply this transitive generator despite ExcludeAssets.
       Remove only this optional vendor source generator from the compiler input, never .NET analyzers. -->
  <Target Name="UseMaxMindJitReader" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'MaxMind.Db.SourceGenerator'" />
    </ItemGroup>
  </Target>
</Project>
