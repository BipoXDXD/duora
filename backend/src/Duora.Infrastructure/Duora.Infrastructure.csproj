<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Duora.Core\Duora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identity, cookies, Data Protection e antiforgery vêm do framework compartilhado do ASP.NET Core: o
         adaptador de identidade (ticket store, SignInManager) mora aqui, ao lado do DbContext. O worker herda a
         referência e roda no mesmo runtime do web. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Só para o dotnet-ef gerar migrations; não vai para quem referencia este projeto. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes de integração aplicam as migrations com o DbContext interno, como fará o job migrador. -->
    <InternalsVisibleTo Include="Duora.IntegrationTests" />
  </ItemGroup>
</Project>
