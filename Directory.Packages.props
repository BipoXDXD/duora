<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aplicação">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <!-- Gera docs/api/openapi.json no build do Duora.Web (ADR-0018); não vai para o binário publicado. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Pinos transitivos">
    <!-- O provider Npgsql pede EF Core >= 10.0.4; fixar o mesmo patch do EF Core Design evita duas versões
         do EF Core no grafo (MSB3277) e traz as correções do último patch da linha 10. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!-- Property-based testing: Apache-2.0, sem dependências transitivas; escrito para C# (o FsCheck traz FSharp.Core). -->
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
