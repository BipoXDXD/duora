<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Aplicação">
    <!-- Cliente S3 oficial (Apache-2.0) do adaptador de object storage de mídia (ADR-0025); assina SigV4 por nós. -->
    <!-- Official AWS clients (Apache-2.0); no age inference requested. -->
    <PackageVersion Include="AWSSDK.Rekognition" Version="4.0.101.5" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.101.4" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.KeyPerFile" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="MaxMind.Db" Version="5.2.0" />
    <!-- SMTP/MIME with mandatory TLS; MailKit and MimeKit are MIT licensed. -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Decoder de fotos, só no Duora.Worker (ADR-0025). Six Labors Split License: exceção presa à versão em
         scripts/supply-chain/license-policy.json; atualizar exige reler o LICENSE da versão nova. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup Label="Build">
    <!-- Gera docs/api/openapi.json no build do Duora.Web (ADR-0018); não vai para o binário publicado. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Pinos transitivos">
    <!-- MimeKit's lower bound is vulnerable; keep the patched runtime line (GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- O provider Npgsql pede EF Core >= 10.0.4; fixar o mesmo patch do EF Core Design evita duas versões
         do EF Core no grafo (MSB3277) e traz as correções do último patch da linha 10. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Benchmark externo - nunca publicado no produto">
    <!-- Cliente oficial Microsoft (MIT), somente Duora.CapacityClient; aprovado no escopo da issue86. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Testes">
    <!-- Property-based testing: Apache-2.0, sem dependências transitivas; escrito para C# (o FsCheck traz FSharp.Core). -->
    <PackageVersion Include="CsCheck" Version="4.9.1" />
    <!-- MIT; somente nos testes de fidelidade das respostas ao JSON Schema 2020-12. -->
    <PackageVersion Include="JsonSchema.Net" Version="7.4.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!-- Contêiner genérico (MinIO do contrato de storage, ADR-0025); mesma versão que o Testcontainers.PostgreSql traz. -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
