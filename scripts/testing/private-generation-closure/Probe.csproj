<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- The independent nested experiment must not be compiled into the baseline executable. -->
    <Compile Remove="boundary/**/*.cs" />
    <!-- Compile the current adapter, not a model or a reimplementation of its PUT. -->
    <Compile Include="../../../backend/src/Duora.Core/Media/IObjectStore.cs" Link="IObjectStore.cs" />
    <Compile Include="../../../backend/src/Duora.Core/Media/ObjectKey.cs" Link="ObjectKey.cs" />
    <Compile Include="../../../backend/src/Duora.Core/Media/PhotoVariants.cs" Link="PhotoVariants.cs" />
    <Compile Include="../../../backend/src/Duora.Infrastructure/Media/ExactLengthStream.cs" Link="ExactLengthStream.cs" />
    <Compile Include="../../../backend/src/Duora.Infrastructure/Media/FileSystemObjectStore.cs" Link="FileSystemObjectStore.cs" />
  </ItemGroup>
</Project>
