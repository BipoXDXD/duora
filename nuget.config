<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Fontes explícitas (spec 2.3 e 17.1): só nuget.org, e todo pacote é mapeado para ela. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
