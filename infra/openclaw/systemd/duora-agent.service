[Unit]
Description=Isolated OpenClaw gateway
Requires=docker.service var-lib-duoraagent.mount
After=docker.service network-online.target var-lib-duoraagent.mount
Wants=network-online.target duora-monitor.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/duora-agent
ExecStartPre=/usr/bin/python3 /opt/duora-agent/preflight.py
ExecStartPre=/bin/sh /opt/duora-agent/firewall.sh
ExecStart=/usr/bin/docker compose --env-file /etc/duora-agent/image.env -f /opt/duora-agent/compose.yml up --no-build --pull never --abort-on-container-exit --exit-code-from gateway
ExecStop=/usr/bin/docker compose --env-file /etc/duora-agent/image.env -f /opt/duora-agent/compose.yml stop --timeout 30
Restart=always
RestartSec=15
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
