# Gerenciado pelo Ansible (infra/ansible/roles/app_dirs). Configuração NÃO sensível do host; segredos ficam em
# {{ duora_secrets_dir }}. Formato KEY=VALUE, sem aspas.
DUORA_IMAGE_PREFIX={{ duora_image_prefix }}
DUORA_SECRETS_DIR={{ duora_secrets_dir }}
DUORA_DOMAIN={{ duora_domain }}
DUORA_TLS={{ duora_tls }}
DUORA_HTTP_PORT=80
DUORA_HTTPS_PORT=443
DUORA_MIN_FREE_GIB={{ duora_min_free_gib }}
DUORA_DISK_CHECK_PATH=/var/lib/docker
# Upload de fotos (Media:Review). Vazio = desligado. Ligado, o duora-deploy exige o backup das fotos verificado
# (timer duora-backup-media-verify ativo e verify bom há no máximo 30 h; adendo do ADR-0010).
DUORA_MEDIA_REVIEW={{ duora_media_review }}
