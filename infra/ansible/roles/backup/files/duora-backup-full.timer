# Gerenciado pelo Ansible (infra/ansible/roles/backup). Full semanal (spec 18.2).
[Unit]
Description=Duora: backup full semanal do PostgreSQL

[Timer]
OnCalendar=Sun *-*-* 03:00:00 UTC
# Sem jitter: horário fixo na janela noturna. Persistent roda o que um reboot fez perder.
Persistent=true
Unit=duora-backup@full.service

[Install]
WantedBy=timers.target
