# Gerenciado pelo Ansible (infra/ansible/roles/backup). Filtro de saída da rede backup-egress.
[Unit]
Description=Duora: filtro de saída do container backup (DOCKER-USER)
# Before=docker.service: no boot o filtro já existe quando o Docker sobe os containers com restart automático, sem
# janela em que o backup saia sem filtro. network-online: a lista de resolvedores do systemd-resolved já existe.
# PartOf reaplica o filtro a cada restart do Docker (para e sobe junto, antes dele).
Wants=network-online.target
After=network-online.target
Before=docker.service
PartOf=docker.service
# Falhar deixa só o DROP na chain (o script falha fechado) e registra o alerta crit.
OnFailure=duora-backup-failed@%n.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/duora-backup-egress

[Install]
WantedBy=docker.service
