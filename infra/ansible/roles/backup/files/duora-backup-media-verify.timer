# Gerenciado pelo Ansible (infra/ansible/roles/backup). Verificação diária do backup das fotos: bucket com File Lock,
# chave presa a media/, snapshot mais novo com no máximo 26 h e estrutura do repositório (restic check, sem baixar
# os dados). Falha dispara duora-backup-failed@.
[Unit]
Description=Duora: verificação diária do backup das fotos

[Timer]
OnCalendar=*-*-* 05:30:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=duora-backup@media-verify.service

[Install]
WantedBy=timers.target
