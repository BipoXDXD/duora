# Gerenciado pelo Ansible (infra/ansible/roles/backup). pgbackrest verify nativo: checksum e tamanho de cada arquivo
# do repositório e continuidade do WAL desde o backup mais novo (spec 18.5 e 19.1). Depois dos backups das 03:00.
[Unit]
Description=Duora: verificação diária do repositório e da cadeia de WAL

[Timer]
OnCalendar=*-*-* 05:00:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=duora-backup@verify-repo.service

[Install]
WantedBy=timers.target
