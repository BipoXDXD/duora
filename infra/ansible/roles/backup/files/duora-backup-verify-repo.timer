# Gerenciado pelo Ansible (infra/ansible/roles/backup). Verificação diária leve (spec 18.5 e 19.1): continuidade do
# WAL pela listagem do archive (sem baixar) e pgbackrest verify --set só do backup mais novo e do WAL dele. O
# repositório inteiro é conferido uma vez por semana (duora-backup-verify-repo-full.timer). Depois dos backups das
# 03:00.
[Unit]
Description=Duora: verificação diária da cadeia de WAL e do backup mais novo

[Timer]
OnCalendar=*-*-* 05:00:00 UTC
RandomizedDelaySec=15min
Persistent=true
Unit=duora-backup@verify-repo.service

[Install]
WantedBy=timers.target
