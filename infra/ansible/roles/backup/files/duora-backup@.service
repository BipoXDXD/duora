# Gerenciado pelo Ansible (infra/ansible/roles/backup). Uma ação do duora-backup por instância:
# duora-backup@full, duora-backup@diff, duora-backup@verify, duora-backup@verify-repo,
# duora-backup@verify-repo-full. Saída diferente de 0
# (inclusive erro inesperado ou resposta que o verify não sabe avaliar) deixa a unit em failed e dispara
# duora-backup-failed@.
[Unit]
Description=Duora: pgBackRest %i (duora-backup)
After=docker.service
Requires=docker.service
OnFailure=duora-backup-failed@%n.service

[Service]
Type=oneshot
# --scheduled: o verify pula durante um deploy, se houver verify bom na última hora (docs/operations/backup-restore.md).
ExecStart=/usr/local/sbin/duora-backup %i --scheduled
NoNewPrivileges=yes
PrivateTmp=yes
