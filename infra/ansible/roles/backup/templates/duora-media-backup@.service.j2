# Gerenciado pelo Ansible (infra/ansible/roles/backup). Uma ação de backup das fotos por instância:
# duora-media-backup@media-backup, duora-media-backup@media-verify e duora-media-backup@media-check. O restic roda no
# host e não depende do daemon de containers (a duora-backup@ depende). Saída diferente de 0 dispara o mesmo alerta do
# backup do banco. O diretório das fotos é o duora_media_dir do inventário, o mesmo DUORA_MEDIA_DIR do Compose; as aspas
# do systemd o mantêm como um argumento só, mesmo com espaço.
[Unit]
Description=Duora: backup das fotos %i (duora-backup, restic)
OnFailure=duora-backup-failed@%n.service

[Service]
Slice=duora-media.slice
Type=oneshot
ExecStart=/usr/local/sbin/duora-backup %i --media-root "{{ duora_media_dir }}"
NoNewPrivileges=yes
PrivateTmp=yes
