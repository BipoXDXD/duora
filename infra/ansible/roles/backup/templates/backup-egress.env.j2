# Gerenciado pelo Ansible (infra/ansible/roles/backup). Lido por /usr/local/sbin/duora-backup-egress.
# Subnet da rede backup-egress do compose.prod.yml (mudar nos dois lugares juntos).
DUORA_BACKUP_SUBNET={{ duora_backup_egress_subnet }}
# Destinos HTTPS permitidos (CIDRs do endpoint S3, separados por espaço). Vazio = qualquer destino na porta 443,
# até o provedor ser escolhido (docs/operations/backup-restore.md, "Pendências").
DUORA_BACKUP_S3_CIDRS={{ duora_backup_s3_cidrs | join(' ') }}
