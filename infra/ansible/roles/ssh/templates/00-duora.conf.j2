# Gerenciado pelo Ansible (infra/ansible/roles/ssh). Spec 15.2: SSH só por chave, sem root e sem senha.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
PermitEmptyPasswords no
AllowUsers {{ duora_admin_user }} {{ duora_deploy_user }}
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no

# O executor de deploy não tem bloco Match aqui: o authorized_keys dele usa "restrict" + command= (role app_dirs).
# Um Match num drop-in incluído no topo engoliria tudo o que viesse depois no sshd_config.
