# Borda única do Duora (spec 15.3): SPA, /api/*, /hubs/* e /webhooks/* na mesma origem. Embutido na imagem edge.
# Variáveis (lidas na carga da configuração):
#   DUORA_DOMAIN  domínio da aplicação (produção: meetduora.com; "localhost" no smoke local)
#   DUORA_TLS     e-mail da conta ACME em produção, ou "internal" para a CA local do Caddy (smoke/homologação)
# Validar: docs/operations/deploy.md ("Validar o Caddyfile").
#
# CSP, HSTS e demais cabeçalhos de segurança vivem só aqui; o backend não deve emitir versões concorrentes.
#
# Sem trusted_proxies: o Caddy não confia em X-Forwarded-* vindo da internet e envia ao web os que ele mesmo viu.
# O backend deve confiar só no Caddy (Forwarded Headers, spec 11.3; pendência do backend).

# Log padrão (erros de handler, como o do reverse_proxy, vão para http.log.error, fora do access log): o mesmo
# filtro de pedido do access log, porque o erro carrega o pedido inteiro. Manter os dois filtros iguais.
{
	log default {
		output stdout
		format filter {
			request>uri multi_regexp {
				regexp \?.*$ ?redacted
				regexp [0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12} {id}
			}
			request>headers delete
			request>tls delete
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			wrap json
		}
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# Microfone só para a própria origem; gesto e consentimento são responsabilidade da SPA (ADR-0028).
		# A política não exige gesto nem concede permissão. Nenhum iframe de outra origem o recebe; e a CSP não carrega iframe algum (default-src 'none', sem frame-src).
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), browsing-topics=()"
		# Coerente com o build do Vite: só módulos e CSS próprios, sem inline e sem eval. wss explícito para o hub
		# (navegadores antigos não estendem 'self' a WebSocket). media-src 'self' para o áudio do catálogo
		# (ADR-0027), sem blob:: a Web Audio lê por fetch() (connect-src) e a voz ao vivo entra por srcObject, fora
		# do Fetch. ICE/TURN não passa por connect-src; sem diretiva webrtc, o WebRTC fica permitido (ADR-0028).
		# Mudou aqui, mude scripts/deploy/test_caddy_security_headers.py.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self' wss://{hostport}; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		-Server
	}
}

{$DUORA_DOMAIN} {
	tls {$DUORA_TLS}
	encode zstd gzip

	# Acesso em JSON no stdout, sem query string, sem cabeçalhos (Cookie, Authorization, Set-Cookie...) e com IP
	# truncado (spec 19.2). Allowlist: o que não está no registro não vaza. UUIDs no caminho viram {id}: rota como
	# /api/v1/me/blocks/{targetUserId} diria quem bloqueou quem (dado P3) ao lado do IP (TM-24, spec 19.2).
	log {
		output stdout
		format filter {
			request>uri multi_regexp {
				regexp \?.*$ ?redacted
				regexp [0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12} {id}
			}
			request>headers delete
			request>tls delete
			resp_headers delete
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			wrap json
		}
	}

	import security_headers

	# Erros de handlers (file_server/proxy) usam uma cadeia separada no Caddy.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "" {err.status_code}
	}

	# Saúde e documentação técnica ficam na rede interna (web:8080), nunca na borda pública.
	@internal path /health /health/* /openapi /openapi/*
	handle @internal {
		respond 404
	}

	# API: status, cookies e cabeçalhos de cache do backend passam intactos; sem Cache-Control, nada é guardado.
	handle /api/* {
		header ?Cache-Control "no-store"
		reverse_proxy web:8080
	}

	# Callbacks de fornecedor (verificação etária, ADR-0024): só o web os autentica, pela assinatura sobre os bytes
	# recebidos. O teto de 64 KiB repete o do backend para o corpo grande morrer na borda, com 413, sem ocupar o web.
	# Sem cache e sem cookie úteis: o fornecedor não é navegador.
	handle /webhooks/* {
		request_body {
			max_size 64KiB
		}
		reverse_proxy web:8080
	}

	# SignalR: WebSocket (e fallbacks de streaming) sem buffer e sem timeout de requisição; numa recarga de config,
	# as conexões abertas duram mais 5 min em vez de reconectarem todas de uma vez.
	handle /hubs/* {
		reverse_proxy web:8080 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	# Assets com hash no nome: imutáveis; arquivo inexistente é 404, nunca o index.html no lugar de JavaScript.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Demais arquivos estáticos (index.html, favicon) sempre revalidados, para uma release nova chegar logo.
	# Fallback da SPA só para navegação de documento; fetch para caminho inexistente recebe 404.
	handle {
		root * /srv
		header Cache-Control "no-cache"

		@spaNavigation {
			not file
			expression `{http.request.header.Sec-Fetch-Mode} == "navigate" || {http.request.header.Accept}.contains("text/html")`
		}
		rewrite @spaNavigation /index.html
		file_server
	}
}

# Saúde do próprio Caddy para o healthcheck do Compose: só no loopback do container, porta não publicada.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz 200
	respond 404
}
