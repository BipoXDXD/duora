<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Necessário para o build aplicar IDE0005 (using desnecessário). Os comentários XML não são
         obrigatórios em código de aplicação, por isso CS1591 fica desligado. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- No CI (GitHub Actions define CI=true) o restore falha se o lockfile divergir. -->
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Data Protection: sem este teto, o DefaultKeyResolver repete com espera a chave que não decifrou, prendendo uma
       thread (às vezes dentro da trava do KeyRingProvider). As chaves do Duora se decifram com certificados locais:
       sem o certificado a falha é definitiva, e repetir só atrasa. Fica aqui, e não num csproj, para valer no
       runtimeconfig do Duora.Web e no dos testes, que hospedam o app no próprio processo. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="Microsoft.AspNetCore.DataProtection.KeyManagement.MaximumTotalDefaultKeyResolverRetries" Value="0" />
  </ItemGroup>
</Project>
